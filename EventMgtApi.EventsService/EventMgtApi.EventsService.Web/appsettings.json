{
  "ConnectionStrings": {
    "DefaultConnection": "Host={YOUR_SERVER_HERE};Port=5432;Database={YOUR_DB_HERE};Username={YOUR_USER_HERE};Password={YOUR_PASSWORD_HERE}"
  },
  "BookingOptions": {
    "MaxActiveBookings": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service-group"
  },  
  "Jwt": {
    "Secret": "{YOUR_SECRET_HERE}",
    "Issuer": "EventMgtApi",
    "Audience": "EventMgtApi",
    "ExpiryMinutes": 60
  },
  "SeedOptions": {
    "Admins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}